# Voice Communication System - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# OpenAI Configuration (for English Chatbot)
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
STT_SERVICE=whisper
TTS_SERVICE=openai

# ============================================
# Kinyarwanda Models Configuration
# ============================================
KINYARWANDA_STT_MODEL=kinyarwanda-stt
KINYARWANDA_LLM_MODEL=kinyarwanda-llm
KINYARWANDA_TTS_MODEL=kinyarwanda-tts

# ============================================
# Orchestrator Configuration
# ============================================
SESSION_TIMEOUT=300
LOG_LEVEL=INFO

# ============================================
# Asterisk Configuration
# ============================================
# SIP port (default: 5060)
SIP_PORT=5060
# RTP port range
RTP_PORT_START=10000
RTP_PORT_END=10100

# ============================================
# Redis Configuration
# ============================================
REDIS_PORT=6379

# ============================================
# Service Ports
# ============================================
ORCHESTRATOR_PORT=8000
ENGLISH_BOT_PORT=8001
KINYARWANDA_BOT_PORT=8002
